# 复制为 .env 后按需修改；生产环境务必改掉所有默认值
TZ=Asia/Shanghai

# MySQL 业务库
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=zhikeban
MYSQL_USER=zhikeban
MYSQL_PASSWORD=change_me_app

# 后端连接串（默认指向 compose 内的 mysql 服务）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=zhikeban
DB_USER=zhikeban
DB_PASSWORD=change_me_app

# 向量存储：mysql（默认，兜底实现）| oracle（可选增强）
VECTOR_STORE=mysql

# 可选：Oracle 23ai（仅在 --profile oracle 时使用）
ORACLE_PWD=change_me_oracle
ORACLE_CHARACTERSET=AL32UTF8

# 可选：MinIO（仅在 --profile storage 时使用）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# 前端开发代理目标
VITE_API_TARGET=http://localhost:8080
